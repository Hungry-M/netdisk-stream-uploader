#: src\cli.py:109
msgid "[INFO] 该任务没有指纹基线，已按当前源文件补记；本次不做比对"
msgstr "[INFO] No fingerprint baseline for this task; recorded one from the current sources. No comparison this run"

#: src\cli.py:122
msgid "\n[ERR] 源文件已变化，中断前上传的分卷无法与新生成的字节流对齐。\n      选择一：`delete {0}` 后重建（会得到新的 task_id，旧分卷留在云端需自行清理）\n      选择二：确认源文件其实没变（例如只改动了 mtime），加 `--verify=off` 强制续传"
msgstr "\n[ERR] Source files changed; volumes uploaded before the interruption cannot line up with the new byte stream.\n      Option 1: `delete {0}` and rebuild (you get a new task_id; old volumes stay in the cloud and must be cleaned up manually)\n      Option 2: if the sources did not really change (e.g. only mtime), force a resume with `--verify=off`"

#: src\cli.py:169
msgid "第 {0} 卷与记录不符：md5 记录 {1}… 实际 {2}…，大小记录 {3} 实际 {4}"
msgstr "Volume {0} does not match the record: md5 recorded {1}… actual {2}…, size recorded {3} actual {4}"

#: src\cli.py:190
msgid "[WARN] 该任务创建时未加密，已忽略密码参数"
msgstr "[WARN] This task was created unencrypted; ignoring the password"

#: src\cli.py:194
msgid "压缩包密码"
msgstr "Archive password"

#: src\cli.py:198
msgid "[ERR] 密码与任务创建时不一致。"
msgstr "[ERR] Password does not match the one used when the task was created."

#: src\cli.py:214
msgid "[CLEAN] 清理了 {0} 个残留分卷"
msgstr "[CLEAN] Removed {0} leftover volumes"

#: src\cli.py:269
msgid "[WARN] 背压上限 {0} 较大，可能占用较多临时空间"
msgstr "[WARN] Backpressure cap {0} is large; it may use a lot of temporary space"

#: src\cli.py:278
msgid "[OK] 任务 {0} 完成！本次上传 {1} 卷, 跳过 {2} 卷"
msgstr "[OK] Task {0} finished. Uploaded {1} volume(s), skipped {2}"

#: src\cli.py:281
msgid "失败分卷: {0}"
msgstr "Failed volumes: {0}"

#: src\cli.py:283
msgid "[WARN] 任务 {0} 部分完成。上传 {1}, 跳过 {2}, 失败 {3}"
msgstr "[WARN] Task {0} partially completed. Uploaded {1}, skipped {2}, failed {3}"

#: src\cli.py:285
msgid "    使用 `resume {0}` 重试失败分卷"
msgstr "    Use `resume {0}` to retry the failed volumes"

#: src\cli.py:288
msgid "所有分卷失败: {0}"
msgstr "All volumes failed: {0}"

#: src\cli.py:289
msgid "[ERR] 任务 {0} 全部失败"
msgstr "[ERR] Task {0} failed entirely"

#: src\cli.py:293
msgid "[ERR] 续传校验失败：{0}"
msgstr "[ERR] Resume verification failed: {0}"

#: src\cli.py:294
msgid "      源文件在中断后被改动过，请 `delete` 后重建任务。"
msgstr "      Source files changed after the interruption; `delete` and rebuild the task."

#: src\cli.py:298
msgid "[STOP] 任务已中断，可通过 `resume` 恢复\n"
msgstr "[STOP] Task interrupted; resume it with `resume`\n"

#: src\cli.py:303
msgid "[ERR] 任务 {0} 异常: {1}"
msgstr "[ERR] Task {0} failed: {1}"

#: src\cli.py:319
msgid "[CLEAN] {0} 个上次中断的任务已标记为 interrupted，可用 `resume <task_id>` 继续"
msgstr "[CLEAN] {0} task(s) from a previous run marked as interrupted; use `resume <task_id>` to continue"

