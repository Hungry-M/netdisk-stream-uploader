msgstr "Resume an existing task with the same parameters"

#: src\cli.py:340
msgid "启用背压。无值=默认上限；--backpressure=20=上限20；不传=不启用"
msgstr "Enable backpressure. No value = default cap; --backpressure=20 = cap 20; omit = disabled"

#: src\cli.py:341
